# URL do painel publicado + /api/public/worker/rpc
PANEL_API_URL=https://SEU-PAINEL.lovable.app/api/public/worker/rpc
# Mesmos valores que você salvou como segredos no painel
WORKER_TOKEN=
IG_ENC_KEY=

# IA com visão (qualquer endpoint compatível com /chat/completions).
# Padrão: Gemini. Para GPT-4o: AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

DATA_DIR=/data
AUTOSTART=true
POLL_SECONDS=5
